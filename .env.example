# Copy to .env and fill in. `docker compose up` fails fast rather than
# starting with a default secret for anything marked REQUIRED.
#
#   cp .env.example .env
#
# Generate every secret below with:
#   openssl rand -hex 32

# -- REQUIRED ---------------------------------------------------------------

# Root secret for per-session key derivation. Never leaves the server.
#
# Changing it invalidates every session key already issued: with
# persistence on, a restart under a new secret restores the sessions but
# derives different keys for them, so a resuming client's frames all fail
# their signature check and the candidate gets flagged for something the
# server did. Set it once, keep it.
PROCTOR_MASTER_SECRET=

POSTGRES_PASSWORD=

# Must match between the LiveKit server, egress, and the gateway. The key
# is an identifier, not a secret; the secret is.
#
# If you change the key name, change it in deploy/livekit.yaml's `webhook:
# api_key:` too — LiveKit does not expand environment variables inside
# that file, so the two cannot be kept in sync automatically. A mismatch
# shows up as the gateway 401-ing every webhook and no recording starting.
LIVEKIT_API_KEY=proctor
LIVEKIT_API_SECRET=

# -- Console access ---------------------------------------------------------

# Bearer token for the proctor console. Leave blank and the gateway
# generates one per run and prints it to the log:
#
#   docker compose logs gateway | grep -A2 "PROCTOR_CONSOLE_TOKEN is unset"
#
# Fine for a first look. Set it explicitly for anything you come back to,
# since a generated one changes on every restart.
PROCTOR_CONSOLE_TOKEN=

# -- Feature gates ----------------------------------------------------------
# Both fail closed: blank means the feature is off. The value is a record
# of the notice candidates were actually shown, not a boolean — an
# unrecorded justification is not a justification.
#
# Quote any value containing spaces. Compose parses this file itself and
# does not need the quotes, but `. ./.env` in a shell does — without them
# it reads the second word as a command and fails with something as
# unhelpful as `shown: command not found`.

# Enables the SFU/recording plane. Without it, no room join and no
# recording, and the candidate's consent dialog says so.
PROCTOR_MEDIA_CONSENT_NOTICE="candidates shown the live-video and recording notice at exam start"

# Enables microphone transcription. Separate from the above on purpose:
# transcribing speech carries wiretap and all-party-consent exposure that
# a video call does not.
PROCTOR_AUDIO_CONSENT_NOTICE=

# -- Retention --------------------------------------------------------------
# Both are policy questions, not technical ones. Tune them to whatever
# your institution's rules actually require.

# Violations and finished sessions.
PROCTOR_RETENTION_DAYS=30

# Recording *references* — the egress id and storage path. Note this does
# not delete the video files themselves from ./data/recordings; that is
# your storage lifecycle policy's job. See
# proctor_gateway.store.purge_recordings_older_than.
PROCTOR_RECORDING_RETENTION_DAYS=14

# -- Ports ------------------------------------------------------------------

GATEWAY_PORT=8000
ADMINER_PORT=8080
POSTGRES_PORT=5432
POSTGRES_USER=proctor
POSTGRES_DB=proctor

# Two LiveKit addresses, because the gateway and the candidate's client
# reach it from different networks and one value cannot serve both.
#
#   _URL         what the *gateway* calls (compose service name)
#   _PUBLIC_URL  what *clients* are told to connect to (host-reachable)
#
# Get this wrong and the symptom is unhelpful: the client silently fails
# to connect to a hostname that resolves nowhere, while the gateway looks
# perfectly healthy.
PROCTOR_LIVEKIT_URL=ws://livekit:7880
PROCTOR_LIVEKIT_PUBLIC_URL=ws://localhost:7880
